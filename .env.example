DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=

# Kushki
KUSHKI_PRIVATE_API_KEY=
KUSHKI_PUBLIC_MERCHANT_ID=
KUSHKI_ENVIRONMENT=sandbox

# Regcheck
REGCHECK_API_KEY=
REGCHECK_BASE_URL=
REGCHECK_CHECK_PATH=/record/{API_KEY}
REGCHECK_WEB_LOGIN_URL=https://app.regcheq.com/login
REGCHECK_WEB_USER=
REGCHECK_WEB_PASSWORD=
REGCHECK_WEB_HEADLESS=true
REGCHECK_WEB_STORAGE_STATE_PATH=.cache/regcheck-storage-state.json

# OpenAI (Sheldon)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MCC_COSTS_TABLE=costos_mcc
SUPABASE_MCC_ANNEXED_TABLE=mcc_anexados_firmados
SUPABASE_MCC_COLUMN=mcc
SUPABASE_MCC_COST_COLUMNS=costo_credito,costo_debito,costo_prepago

# Email (rechazos)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=success@fintoc.com

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_ALERTS_CHANNEL=
